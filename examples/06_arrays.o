// 06 - Arrays
// Array[T] is a generic library class. Generics are NOT part of the
// implementation scope, but Array[Integer] must still be parsed as a
// class name with a type argument.
//
// OPEN QUESTION: indices are assumed 1-based here, following the
// MaxInt example in the spec. This is never stated explicitly.

class ArrayDemo is

    method maxOf(a: Array[Integer]) : Integer is
        var max : a.get(1)
        var i : Integer(2)
        while i.LessEqual(a.Length) loop
            if a.get(i).Greater(max) then
                max := a.get(i)
            end
            i := i.Plus(1)
        end
        return max
    end

    method sumOf(a: Array[Integer]) : Integer is
        var total : Integer(0)
        var i : Integer(1)
        while i.LessEqual(a.Length) loop
            total := total.Plus(a.get(i))
            i := i.Plus(1)
        end
        return total
    end

    // OPEN QUESTION: 'a.set(i, v)' returns nothing, so it can only appear
    // as a statement. But Statement is defined as
    //     Assignment | WhileLoop | IfStatement | ReturnStatement
    // -- there is no expression statement in the grammar, so a call to a
    // void method is unreachable. Written here as it would naturally be.
    method fill(a: Array[Integer], value: Integer) is
        var i : Integer(1)
        while i.LessEqual(a.Length) loop
            a.set(i, value)
            i := i.Plus(1)
        end
    end

    this is
        var numbers : Array[Integer](10)
    end
end
